# ===================================================================
# COLLAGE ERP — Environment Configuration
# ===================================================================

# 1. PostgreSQL Database URL (Neon, Supabase, Railway, or local Postgres)
# Example: postgresql://postgres:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/collage?sslmode=require
DATABASE_URL=

# 2. Initial Admin Email (Authorized to bootstrap admin role)
COLLAT_INITIAL_ADMIN_EMAIL=admin@collage.com.gh

# 3. Clerk Authentication (Optional for production auth)
# Obtain from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# 4. Port Settings (Default dev server is 3009)
PORT=3009
