{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots\\.txt|collage-logo).*)",
      "destination": "/index.html"
    }
  ]
}
